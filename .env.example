# Official hosted NSE MCP endpoints
NSE_BHAVCOPY_MCP_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_CM_MARKET_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp

APP_NAME=NSE AI Research
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
PREMARKET_REPORT_TIME=09:00
DATABASE_URL=sqlite:///./data/nse_research.db
LOG_LEVEL=INFO

# Optional future LLM integration; market data must still come from NSE MCP.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Live integration tests are disabled unless explicitly enabled.
RUN_NSE_INTEGRATION=0
